# BioGuard Web - Variables de entorno (PLANTILLA)
# Copia este archivo a `.env` y completa los valores.
# IMPORTANTE: aqui SOLO van valores publicos (prefijo VITE_*).
# Ningun secreto de servidor (Stripe secret, SMTP, MongoDB, etc.)
# debe declararse ni commitearse en el frontend: solo se exponen
# en el bundle las variables con prefijo VITE_.

# URL base de la API de BioGuard (backend)
VITE_API_URL=http://localhost:5050

# URL pública de la app web (se usa para armar los QR de acceso)
# En desarrollo puede omitirse (usa window.location.origin)
VITE_APP_URL=
